<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Zonas de red de este repo (Settings → Firewall). Instalado por Settings. -->
<policyconfig>
  <action id="org.dotfiles.netguard.apply">
    <description>Apply the network zone (kill switch, discovery)</description>
    <message>Apply the security of this network</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/netguard/apply</annotate>
  </action>
  <action id="org.dotfiles.netguard.auth">
    <description>Lower the network protection</description>
    <message>Authenticate to lower the protection of this network</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/netguard/auth</annotate>
  </action>
</policyconfig>
