#!/usr/bin/python3 -I
"""netguard-root — la parte con root de las zonas de red (Settings → Firewall).

NO se ejecuta desde este repo: Settings la instala (sudo, una vez) en
/usr/local/lib/netguard/ como root:root 0755 junto con dos wrappers que pkexec
llama según la policy org.dotfiles.netguard:

  apply  (sin contraseña: lo usa el daemon para aplicar el modo de la red)
    killswitch on <ip>...   arma el kill switch: solo salen túneles + lo
                            necesario para levantar uno (endpoints, DHCP, ND)
    killswitch refresh <ip>...  cambia los endpoints sin desarmar
    killswitch off          lo desarma (volver a una red segura)
    discovery on|off        Avahi (mDNS/LLMNR por conexión los maneja NetworkManager)
    status                  JSON con el estado
  auth   (pide huella o contraseña al agente de polkit)
    check                   solo autentica (gate de Bluetooth, USB, trusted…)
    bypass <segundos>       desarma el kill switch un rato (portal cautivo,
                            login SAML de Forti/Citrix) y lo rearma solo

Todo argumento se valida (IPs, nombres de interfaz, números): nunca se pasa
nada a un shell ni se lee configuración de un directorio del usuario. Los
endpoints del último `on` quedan en /run/netguard/ para rearmar tras un bypass.
"""

import ipaddress
import json
import os
import subprocess
import sys
import time

RUN = "/run/netguard"
ENDPOINTS = f"{RUN}/endpoints.json"
BYPASS = f"{RUN}/bypass_until"
TABLE = "netguard"
SELF = "/usr/local/lib/netguard/netguard-root"


def die(msg: str, code: int = 2) -> None:
    print(f"netguard-root: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(*cmd: str, check: bool = False, inp: str | None = None) -> subprocess.CompletedProcess:
    r = subprocess.run(list(cmd), capture_output=True, text=True, input=inp, timeout=30)
    if check and r.returncode:
        die(f"{cmd[0]} failed: {r.stderr.strip()}", 1)
    return r


def parse_ips(args: list[str]) -> tuple[list[str], list[str]]:
    v4, v6 = [], []
    for a in args:
        try:
            ip = ipaddress.ip_address(a)
        except ValueError:
            die(f"not an IP address: {a!r}")
        (v4 if ip.version == 4 else v6).append(str(ip))
    return sorted(set(v4)), sorted(set(v6))


def ruleset(v4: list[str], v6: list[str]) -> str:
    """Tabla propia (convive con firewalld): output con policy drop.

    - lo y todo túnel (oiftype 65534 (ARPHRD_NONE) = wireguard/tun, ppp = Forti) salen.
    - Tailscale marca su propio tráfico cifrado con 0x80000: sale (si no, se
      rompe la conexión con los equipos propios).
    - Para levantar un túnel: los endpoints del pool, DHCP/DHCPv6 y el
      descubrimiento de vecinos/routers de IPv6.
    - Lo demás se descarta (sin "established": una conexión abierta antes de
      armar no sigue saliendo por fuera del túnel)."""
    e4 = f"elements = {{ {', '.join(v4)} }}" if v4 else ""
    e6 = f"elements = {{ {', '.join(v6)} }}" if v6 else ""
    return f"""table inet {TABLE} {{
  set endpoints4 {{ type ipv4_addr; {e4} }}
  set endpoints6 {{ type ipv6_addr; {e6} }}
  chain output {{
    type filter hook output priority -10; policy drop;
    oif "lo" accept
    meta oiftype {{ 65534, ppp }} accept
    meta mark & 0x00ff0000 == 0x00080000 accept
    ip daddr @endpoints4 accept
    ip6 daddr @endpoints6 accept
    udp sport 68 udp dport 67 accept
    udp sport 546 udp dport 547 accept
    icmpv6 type {{ nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert }} accept
    counter drop
  }}
}}
"""


def table_exists() -> bool:
    return sh("nft", "list", "table", "inet", TABLE).returncode == 0


def killswitch_on(args: list[str], refresh: bool = False) -> None:
    v4, v6 = parse_ips(args)
    os.makedirs(RUN, mode=0o755, exist_ok=True)
    with open(ENDPOINTS + ".tmp", "w") as f:
        json.dump({"v4": v4, "v6": v6}, f)
    os.replace(ENDPOINTS + ".tmp", ENDPOINTS)
    if refresh and not table_exists():
        return      # refresh no arma: si está desarmado (bypass) queda así
    # Reemplazo atómico: borrar y crear en la misma transacción de nft
    pre = f"delete table inet {TABLE}\n" if table_exists() else ""
    sh("nft", "-f", "-", check=True, inp=pre + ruleset(v4, v6))
    try:
        os.unlink(BYPASS)
    except FileNotFoundError:
        pass


def killswitch_off() -> None:
    if table_exists():
        sh("nft", "delete", "table", "inet", TABLE, check=True)


def rearm() -> None:
    """Después de un bypass: vuelve a armar con los últimos endpoints, salvo que
    entretanto se haya desarmado a propósito (no queda archivo de bypass)."""
    if not os.path.exists(BYPASS):
        return
    try:
        with open(ENDPOINTS) as f:
            e = json.load(f)
    except (OSError, ValueError):
        e = {"v4": [], "v6": []}
    killswitch_on(e.get("v4", []) + e.get("v6", []))


def bypass(secs: str) -> None:
    if not secs.isdigit() or not 10 <= int(secs) <= 900:
        die("bypass takes 10..900 seconds")
    if not table_exists():
        return
    killswitch_off()
    os.makedirs(RUN, mode=0o755, exist_ok=True)
    with open(BYPASS, "w") as f:
        f.write(str(int(time.time()) + int(secs)))
    sh("systemd-run", "--quiet", "--collect", f"--on-active={int(secs)}", "--unit=netguard-rearm",
       "/usr/bin/python3", "-I", SELF, "--via=timer", "rearm")


def discovery(state: str) -> None:
    if state == "off":
        sh("systemctl", "stop", "avahi-daemon.socket", "avahi-daemon.service")
    elif state == "on":
        sh("systemctl", "start", "avahi-daemon.socket", "avahi-daemon.service")
    else:
        die("discovery on|off")


def status() -> None:
    until = 0
    try:
        with open(BYPASS) as f:
            until = int(f.read().strip() or 0)
    except (OSError, ValueError):
        pass
    print(json.dumps({"killswitch": table_exists(), "bypass_until": until,
                      "avahi": sh("systemctl", "is-active", "avahi-daemon").stdout.strip() == "active"}))


def main() -> None:
    args = sys.argv[1:]
    if not args or not args[0].startswith("--via="):
        die("call it through /usr/local/lib/netguard/apply or auth")
    via, args = args[0][6:], args[1:]
    if os.geteuid() != 0:
        die("needs root (pkexec)")
    cmd = args[0] if args else ""
    if via == "timer" and cmd == "rearm":
        return rearm()
    if via == "auth":
        if cmd == "check":
            return
        if cmd == "bypass" and len(args) == 2:
            return bypass(args[1])
        die("auth: check | bypass <secs>")
    if via == "apply":
        if cmd == "killswitch" and len(args) >= 2 and args[1] in ("on", "refresh"):
            return killswitch_on(args[2:], refresh=args[1] == "refresh")
        if cmd == "killswitch" and args[1:] == ["off"]:
            return killswitch_off()
        if cmd == "discovery" and len(args) == 2:
            return discovery(args[1])
        if cmd == "status":
            return status()
    die(f"unknown command for {via}: {' '.join(args)}")


if __name__ == "__main__":
    main()
