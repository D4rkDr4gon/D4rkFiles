[Unit]
Description=Hyprland graphical session initialization
Documentation=https://wiki.hyprland.org/
# Pull in graphical-session.target (que tiene RefuseManualStart=yes)
# para que xdg-desktop-portal.service y otros servicios gráficos arranquen
Requires=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true

[Install]
WantedBy=default.target
