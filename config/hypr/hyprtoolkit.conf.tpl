# hyprtoolkit.conf — GENERADO desde hyprtoolkit.conf.tpl por scripts/theme-switch.sh. No editar.
# Lo usa hyprpolkitagent (diálogo de contraseña/huella de polkit). Colores hyprlang 0xAARRGGBB;
# base/alternate_base = rampa chip_*. Lo lee al arrancar: theme-switch.sh reinicia el agente.
background = 0xff@background_hex@
base = 0xff@chip_battery_hex@
alternate_base = 0xff@chip_bluetooth_hex@
text = 0xff@foreground_hex@
bright_text = 0xff@foreground_hex@
accent = 0xff@primary_hex@
accent_secondary = 0xff@secondary_hex@
font_family = @font_ui_or_mono@
font_family_monospace = @font_mono@
rounding_large = @radius@
rounding_small = @radius_half@
